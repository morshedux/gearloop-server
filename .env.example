PORT=5000
# MongoDB Atlas connection string (keep secret)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=gearloop

# Shared secret used to sign/verify JWTs (must match the client's JWT_SECRET)
JWT_SECRET=change-me-to-a-long-random-string

# Stripe test secret key
STRIPE_SECRET_KEY=sk_test_xxx

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# Secret for the scheduled booking-completion endpoint (Vercel Cron)
CRON_SECRET=change-me

# Optional SMTP settings for booking-completed emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GearLoop <no-reply@gearloop.app>"
